rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 32000 &&
             data.senderType is string &&
             data.senderType in ['USER', 'BOT'] &&
             (!('source' in data) || (
               data.source is string &&
               data.source in ['GEMINI', 'DATABASE', 'WEB', 'LLM', 'SYSTEM', 'NONE']
             )) &&
             (!('modelId' in data) || (data.modelId is string && data.modelId.size() <= 80)) &&
             (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 80)) &&
             data.clientTimestampMillis is int &&
             data.clientTimestampMillis >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidLearnedQa(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.question is string &&
             data.question.size() >= 1 &&
             data.question.size() <= 500 &&
             data.answer is string &&
             data.answer.size() >= 1 &&
             data.answer.size() <= 2000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'text', 'senderType', 'clientTimestampMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'text', 'senderType', 'source', 'modelId', 'roleTitle', 'clientTimestampMillis', 'createdAt', 'updatedAt']) &&
                         isValidChatMessage(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatMessage(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'source', 'modelId', 'roleTitle', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /learned_qa/{qaId} {
        allow get: if isOwner(userId) && isValidId(qaId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(qaId) &&
                         incoming().keys().hasAll(['userId', 'question', 'answer', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'question', 'answer', 'createdAt', 'updatedAt']) &&
                         isValidLearnedQa(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(qaId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidLearnedQa(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['question', 'answer', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(qaId);
      }
    }
  }
}
